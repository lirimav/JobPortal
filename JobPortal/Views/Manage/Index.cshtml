@model JobPortal.Models.IndexViewModel
@using Microsoft.AspNet.Identity
@using Microsoft.AspNet.Identity.EntityFramework
@using JobPortal.Models;
@{
    var userManager = new UserManager<ApplicationUser>(new UserStore<ApplicationUser>(new ApplicationDbContext()));
    var category = new ApplicationDbContext().Categories.Find(Model.CategoriesId);
}
@{
    ViewBag.Title = "Manage";
}

<main aria-labelledby="title" style="margin-bottom: 4em;">
    <h2 id="title">Account Profile</h2>
    <p class="text-success">@ViewBag.StatusMessage</p>
    <div>
        <h4>View and edit your account profile</h4>
        <hr />
        <div class="accDiv">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-3">
                                <p class="mb-0">Full Name</p>
                            </div>
                            <div class="col-sm-9">
                                <p class="text-muted mb-0">@Model.FullName</p>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-sm-3">
                                <p class="mb-0">Email</p>
                            </div>
                            <div class="col-sm-9">
                                <p class="text-muted mb-0">@Model.Email</p>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-sm-3">
                                <p class="mb-0">Phone</p>
                            </div>
                            <div class="col-sm-9">
                                <p class="text-muted mb-0">@Model.PhoneNr</p>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-sm-3">
                                <p class="mb-0">Address</p>
                            </div>
                            <div class="col-sm-9">
                                <p class="text-muted mb-0">@Model.Address</p>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-sm-3">
                                <p class="mb-0">Registration Date</p>
                            </div>
                            <div class="col-sm-9">
                                <p class="text-muted mb-0">@Model.InsertedOn.ToString("d")</p>
                            </div>
                        </div>
                        @if (Request.IsAuthenticated && userManager.IsInRole(User.Identity.GetUserId(), "Admin")
                        || Request.IsAuthenticated && userManager.IsInRole(User.Identity.GetUserId(), "Employer"))
                        {
                        }
                        else
                        {
                            <hr>
                            <div class="row">
                                <div class="col-sm-3">
                                    <p class="mb-0">Job Category</p>
                                </div>
                                <div class="col-sm-9">
                                    <p class="text-muted mb-0">@category.Name</p>
                                </div>
                            </div>
                        }

                    </div>
                </div>
                @if (Request.IsAuthenticated && userManager.IsInRole(User.Identity.GetUserId(), "Admin")
                    || Request.IsAuthenticated && userManager.IsInRole(User.Identity.GetUserId(), "Employer"))
                {
                    <p></p>
                }
                else
                {
                    <p class="editP">
                        @Html.ActionLink("My jobs", "Index", "JobApplication")
                    </p>
                }
                <p class="editP">
                    @Html.ActionLink("Edit account", "EditUser", "User", new { Id = Model.Id }, null)
                </p>
                <p class="">
                    @if (Model.HasPassword)
                    {
                        @Html.ActionLink("Change your password", "ChangePassword", new { area = "" }, new { @class = "btn btn-outline-dark" })
                    }
                    else
                    {
                        @Html.ActionLink("Create", "SetPassword")
                    }
                </p>
