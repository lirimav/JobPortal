@model JobPortal.Models.ViewModels.ContactViewModel
@{
    ViewBag.Title = "Contact";
}

<main aria-labelledby="title" style="margin-bottom: 4em;">
    <h2 id="title">@ViewBag.Title</h2>

        <div class="row align-items-center">
            <div class="col-lg-7 mb-5 mb-lg-0 mt-5">

                @using (Html.BeginForm("Contact", "Home", FormMethod.Post))
                {
                    <div class="row">
                        <div class="col-md-6 form-group">
                            @Html.LabelFor(m => m.Name)
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Name)
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 form-group">
                            @Html.LabelFor(m => m.Email)
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Email)
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 form-group">
                            @Html.LabelFor(m => m.Message)
                            @Html.TextAreaFor(m => m.Message, new { @class = "form-control", rows = "7" })
                            @Html.ValidationMessageFor(m => m.Message)
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <input type="submit" value="Send Message" class="btn btn-primary rounded-0 py-2 px-4">
                            <span class="submitting"></span>
                        </div>
                    </div>
                }

                @if (ViewBag.Success != null && ViewBag.Success)
                {
                    <div class="alert alert-success mt-3" role="alert">
                        Thank you for contacting us! We will get back to you as soon as possible.
                    </div>
                }

            </div>
            <div class="col-lg-4 ml-auto">
                <h3 class="mb-4">Let's talk about everything.</h3>
                <p>
                    Welcome to our contact page! We're here to talk about everything related to your
                    job search and career goals. Our team is always available to assist you with any questions
                    or concerns you may have. Whether you need help navigating our platform or simply want to
                    discuss the job market, we're here to listen and support you. Contact us today and let's
                    talk about everything!
                </p>
            </div>
        </div>
    <address>
        <strong>Support:</strong>   <a href="mailto:lirim.dev@gmail.com">Support@example.com</a><br />
        <strong>Marketing:</strong> <a href="mailto:lirim.dev@gmail.com">Marketing@example.com</a>
    </address>
</main>