@{
    ViewBag.Title = "Contact";
}
<main aria-labelledby="title" style="margin-bottom: 4em;">
    <h2 id="title">@ViewBag.Title</h2>

    <div class="row align-items-center">
        <div class="col-lg-7 mb-5 mb-lg-0 mt-5">
            <form class="border-right pr-5 mb-5 row gap-2" method="post" id="contactForm" name="contactForm" novalidate="novalidate">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <input type="text" class="form-control" name="fname" id="fname" placeholder="Full Name">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 form-group">
                        <input type="text" class="form-control" name="email" id="email" placeholder="Email">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 form-group">
                        <textarea class="form-control" name="message" id="message" cols="30" rows="7" placeholder="Write your message"></textarea>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <input type="submit" value="Send Message" class="btn btn-primary rounded-0 py-2 px-4">
                        <span class="submitting"></span>
                    </div>
                </div>
            </form>
            <div id="form-message-warning mt-4"></div>
@*            <div id="form-message-success">
                Your message was sent, thank you!
            </div>*@
        </div>
        <div class="col-lg-4 ml-auto">
            <h3 class="mb-4">Let's talk about everything.</h3>
            <p>Welcome to our contact page! We're here to talk about everything related to your 
            job search and career goals. Our team is always available to assist you with any questions 
            or concerns you may have. Whether you need help navigating our platform or simply want to
            discuss the job market, we're here to listen and support you. Contact us today and let's 
            talk about everything!</p>
        </div>
    </div>

    <address>
        <strong>Support:</strong>   <a href="mailto:lirim.dev@gmail.com">Support@example.com</a><br />
        <strong>Marketing:</strong> <a href="mailto:lirim.dev@gmail.com">Marketing@example.com</a>
    </address>
</main>