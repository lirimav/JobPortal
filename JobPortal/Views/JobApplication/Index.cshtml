@model List<JobPortal.Models.ViewModels.JobsVm>
@using Microsoft.AspNet.Identity
@using Microsoft.AspNet.Identity.EntityFramework
@using JobPortal.Models;
@{
    var userManager = new UserManager<ApplicationUser>(new UserStore<ApplicationUser>(new ApplicationDbContext()));

}
@{
    ViewBag.Title = "Index";
}

<h2>Jobs that you applied</h2>

<hr />
<div>
    <div class='div6'>
        @if (Model.Count == 0)
        {
            <p>You have not applied for any jobs.</p>
        }
        else
        {
            foreach (var item in Model)
            {
                <div style="display: flex; flex-direction: column; gap: 0.5rem /* 8px */; padding-top: 1rem /* 16px */; padding-bottom: 1rem /* 16px */;">
                    <h1 style="font-size: 1.25rem /* 20px */; line-height: 1.75rem /* 28px */; font-weight: 700; width: 50%;">@item.Job - <strong>@item.Company</strong></h1>
                    <p style="font-weight: 700; text-align: start;">@item.Description</p>
                    <div style="display: flex; flex-direction: row; gap: 0.5rem /* 8px */; width: max-content;">
                        <p style="border: 1px solid black; padding-right: 0.75rem /* 12px */; padding-left: 0.75rem /* 12px */; padding-top: 0.4rem /* 6.4px */; padding-bottom: 0.4rem /* 6.4px */; border-radius: 9999px; font-weight: 700; font-size: 0.875rem /* 14px */; line-height: 1.25rem /* 20px */; display: flex; gap: 0.25rem /* 4px */; align-items: center;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt" viewBox="0 0 16 16">
                                <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A31.493 31.493 0 0 1 8 14.58a31.481 31.481 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94zM8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10z" />
                                <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                            </svg>
                            @item.Location
                        </p>
                        <p style="border: 1px solid black; padding-right: 0.75rem /* 12px */; padding-left: 0.75rem /* 12px */; padding-top: 0.4rem /* 6.4px */; padding-bottom: 0.4rem /* 6.4px */; border-radius: 9999px; font-weight: 700; font-size: 0.875rem /* 14px */; line-height: 1.25rem /* 20px */; display: flex; gap: 0.25rem /* 4px */; align-items: center;">
                            Added: @item.InsertedOn.ToString("d")
                        </p>
                        <p style="border: 1px solid black; padding-right: 0.75rem /* 12px */; padding-left: 0.75rem /* 12px */; padding-top: 0.4rem /* 6.4px */; padding-bottom: 0.4rem /* 6.4px */; border-radius: 9999px; font-weight: 700; font-size: 0.875rem /* 14px */; line-height: 1.25rem /* 20px */; display: flex; gap: 0.25rem /* 4px */; align-items: center;">
                            Expires: @item.ExpirationDate.ToString("d")
                        </p>
                    </div>
                </div>
                <hr class='border-gray-400' />
            }
        }
    </div>
</div>