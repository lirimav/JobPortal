@model  List<JobPortal.Models.ViewModels.JobsVm>
@using Microsoft.AspNet.Identity
@using JobPortal.Models;
@{
    var context = new ApplicationDbContext();
}
@{
    ViewBag.Title = "Home Page";
}

<main>
    <div class='div1'>
        <div class='div2'>
            <p class='p1'>
                We're hiring!
            </p>
        </div>
        <div class='div3'>
            <h1 class='h1'>Be part of our mission</h1>
            <p class='p2'>
                We're looking for passionate people to join us on our mission. We value fiat hierarchies
                , clear communication, and full ownership and responsibility.
            </p>
        </div>

        <div class='div4'>
        </div>

        <div class='div5'>
            @foreach (var category in ViewBag.CategoriesVm)
            {
                <div style="display: flex; align-items: center; color: black;">
                    <a href="@Url.Action("Index", "Home", new { categoryId = category.Id })" style="color: black;">
                        <p class="btn btn-outline-dark" style="padding-right: 0.75rem; padding-left: 0.75rem; padding-top: 0.4rem; padding-bottom: 0.4rem; border-radius: 9999px; font-weight: 700; font-size: 0.875rem;border: 1px solid black">
                            @category.Name
                        </p>
                    </a>
                </div>
            }
        </div>

    </div>



    <div class='div6'>
        @foreach (var item in Model)
        {
            <hr />
            <div style="display: flex; flex-direction: column; gap: 0.5rem /* 8px */; padding-top: 1rem /* 16px */; padding-bottom: 1rem /* 16px */;">
                @using (Html.BeginForm("ApplyForJob", "Home", new { jobId = item.Id }))
                {
                    <div style="display: flex; flex-direction: column; gap: 0.5rem /* 8px */; padding-top: 1rem /* 16px */; padding-bottom: 1rem /* 16px */;">
                        <button type="submit" style="color: #2d2ca1; text-decoration-line: none; font-size: 1.25rem /* 20px */; line-height: 1.75rem /* 28px */; font-weight: 700; display: flex; align-items: center; align-self: end; position: absolute; border: none; background-color: transparent;">
                            Apply<svg width="22px" height="22px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-up-right"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                        </button>
                    </div>
                }
                <h1 style="font-size: 1.25rem /* 20px */; line-height: 1.75rem /* 28px */; font-weight: 700; width: 50%;">@item.Job - <strong>@item.Company</strong></h1>
                <p style="font-weight: 700; text-align: start;">@item.Description</p>
                <div style="display: flex; flex-direction: row; gap: 0.5rem /* 8px */; width: max-content;">
                    <p style="border: 1px solid black; padding-right: 0.75rem /* 12px */; padding-left: 0.75rem /* 12px */; padding-top: 0.4rem /* 6.4px */; padding-bottom: 0.4rem /* 6.4px */; border-radius: 9999px; font-weight: 700; font-size: 0.875rem /* 14px */; line-height: 1.25rem /* 20px */; display: flex; gap: 0.25rem /* 4px */; align-items: center;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt" viewBox="0 0 16 16">
                            <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A31.493 31.493 0 0 1 8 14.58a31.481 31.481 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94zM8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10z" />
                            <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                        </svg>
                        @item.Location
                    </p>
                    <p style="border: 1px solid black; padding-right: 0.75rem /* 12px */; padding-left: 0.75rem /* 12px */; padding-top: 0.4rem /* 6.4px */; padding-bottom: 0.4rem /* 6.4px */; border-radius: 9999px; font-weight: 700; font-size: 0.875rem /* 14px */; line-height: 1.25rem /* 20px */; display: flex; gap: 0.25rem /* 4px */; align-items: center;">
                        Added: @item.InsertedOn.ToString("d")
                    </p>
                    <p style="border: 1px solid black; padding-right: 0.75rem /* 12px */; padding-left: 0.75rem /* 12px */; padding-top: 0.4rem /* 6.4px */; padding-bottom: 0.4rem /* 6.4px */; border-radius: 9999px; font-weight: 700; font-size: 0.875rem /* 14px */; line-height: 1.25rem /* 20px */; display: flex; gap: 0.25rem /* 4px */; align-items: center;">
                        Expires: @item.ExpirationDate.ToString("d")
                    </p>
                </div>
            </div>
        }

        @if(!Model.Any())
        {
            <h5>No jobs available at the moment.</h5>
        }
        <hr class='border-gray-400' />
    </div>

    <div class='div7'>
        <h1 class='h2'>
            Untitled truly values work-life balance. We work hard and deliver, but at the end
            of the day you can switch off.
        </h1>

        @*<div class='div8'>
                <div class='div9'>
                    <p style="font-weight: 700;">Lirim Avdyli</p>
                    <p style="color: rgb(75 85 99)">React Developer</p>
                </div>
            </div>*@

    </div>
</main>